---
import { Icon } from "astro-icon/components";
import { defaultLang, languages, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(defaultLang);

const fallbackLangs = (Object.keys(languages) as Lang[]).filter(
  (lang) => lang !== defaultLang,
);
---

<footer class="site-footer">
  <nav id="lang-switcher" class="lang-switcher" aria-label="Idioma">
    {
      fallbackLangs.map((lang) => (
        <button type="button" data-lang={lang}>
          {languages[lang]}
        </button>
      ))
    }
  </nav>
  <div class="footer-links">
    <a
      href="https://github.com/dieguedev/blehhh"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="mdi:github" width={24} height={24} />
      <span>{t("footer.github")}</span>
    </a>
    <a
      href="https://buymeacoffee.com/diegue"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="bmc-logo" width={24} height={24} />
      <span data-i18n="footer.support">{t("footer.support")}</span>
    </a>
  </div>
  <div class="footer-spacer" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.5rem 1rem 1rem;
    font-family: "Montserrat", sans-serif;
    font-size: 0.9rem;
    line-height: 1;
  }

  .footer-links {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .lang-switcher,
  .footer-spacer {
    flex: 1 0 0;
  }

  .footer-spacer {
    min-width: 0;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #f9f5ec;
    border-radius: 999px;
    padding: 1rem;
  }

  .lang-switcher {
    display: inline-flex;
    align-items: center;
    align-self: flex-end;
    gap: 0.5rem;
  }

  .lang-switcher button {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .lang-switcher button:hover,
  .lang-switcher button:focus-visible {
    color: #6b5b3f;
  }

  @media (max-width: 640px) {
    .site-footer {
      flex-direction: column;
      justify-content: center;
      gap: 24px;
    }

    .footer-links {
      order: 1;
      flex-direction: column;
    }

    .lang-switcher {
      order: 2;
      flex: none;
      justify-content: center;
      align-self: center;
    }

    .footer-spacer {
      display: none;
    }
  }
</style>
