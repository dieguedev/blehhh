---
import { Icon } from "astro-icon/components";
---

<footer class="site-footer">
  <a
    href="https://github.com/dieguedev"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="mdi:github" width={24} height={24} />
    <span>Github</span>
  </a>
  <a
    href="https://buymeacoffee.com/diegue"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="bmc-logo" width={24} height={24} />
    <span>Support the domain :)</span>
  </a>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    align-self: center;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.5rem 0 1rem;
    font-family: "Montserrat", sans-serif;
    font-size: 0.9rem;
    line-height: 1;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #f9f5ec;
    border-radius: 999px;
    padding: 1rem;
  }
</style>
