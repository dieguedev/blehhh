---
import notBleh from "../assets/not-bleh.png";
import blehhh from "../assets/blehhh.png";
import blehSound from "../assets/bleh.mp3";
import { defaultLang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(defaultLang);
---

<div class="stage">
  <div class="cat-wrap">
    <button
      id="bleh-button"
      class="bleh"
      type="button"
      aria-label="Bleh"
      data-not-bleh={notBleh.src}
      data-bleh={blehhh.src}
    >
      <img id="bleh-image" class="image" src={notBleh.src} alt="" />
    </button>
    <div class="hint">
      <span class="hint-text" data-i18n="hint.text">{t("hint.text")}</span>
    </div>
  </div>
  <audio id="bleh-audio" src={blehSound}></audio>
</div>

<style>
  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    padding: 1rem;
    box-sizing: border-box;
    overflow: hidden;
    container-type: size;
  }

  .cat-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    max-height: 100%;
  }

  .hint {
    color: #000;
    pointer-events: none;
  }

  .hint-text {
    font-family: "Montserrat", sans-serif;
    font-weight: 400;
    font-size: clamp(1.25rem, 3.2cqw, 2rem);
    text-align: center;
  }

  .bleh {
    display: block;
    width: min(650px, 75cqw, 55cqh);
    aspect-ratio: 1 / 1;
    padding: 0;
    border: none;
    background: none;
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    touch-action: manipulation;
    user-select: none;
  }

  .bleh:focus,
  .bleh:focus-visible {
    outline: none;
  }

  .image {
    display: block;
    position: relative;
    top: -1px;
    width: 100%;
    height: calc(100% + 2px);
    object-fit: cover;
  }
</style>

<script>
  const button = document.getElementById("bleh-button") as HTMLButtonElement;
  const image = document.getElementById("bleh-image") as HTMLImageElement;
  const audio = document.getElementById("bleh-audio") as HTMLAudioElement;

  const notBlehSrc = button.dataset.notBleh!;
  const blehSrc = button.dataset.bleh!;

  new Image().src = blehSrc;

  let isAnimating = false;

  button.addEventListener("click", () => {
    if (isAnimating) return;
    isAnimating = true;
    button.disabled = true;

    image.src = blehSrc;
    audio.currentTime = 0;
    audio.play();

    setTimeout(() => {
      image.src = notBlehSrc;
      isAnimating = false;
      button.disabled = false;
    }, 1300);
  });
</script>
