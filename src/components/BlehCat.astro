---
import notBleh from "../assets/not-bleh.png";
import blehhh from "../assets/blehhh.png";
import blehSound from "../assets/bleh.mp3";
import { defaultLang } from "../i18n/ui";
import { useTranslations, interpolate } from "../i18n/utils";

const t = useTranslations(defaultLang);
const counterPlaceholder = interpolate(t("counter.text"), { count: "…" });
---

<div class="stage">
  <div class="cat-wrap">
    <button
      id="bleh-button"
      class="bleh"
      type="button"
      aria-label="Bleh"
      data-not-bleh={notBleh.src}
      data-bleh={blehhh.src}
    >
      <img id="bleh-image" class="image" src={notBleh.src} alt="" />
    </button>
    <div class="hint">
      <span class="hint-text" data-i18n="hint.text">{t("hint.text")}</span>
    </div>
    <div class="counter" aria-live="polite">
      <span id="bleh-count" data-i18n="counter.text" data-i18n-count="…">{counterPlaceholder}</span>
    </div>
  </div>
  <audio id="bleh-audio" src={blehSound}></audio>
</div>

<style>
  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    padding: 1rem;
    box-sizing: border-box;
    overflow: hidden;
    container-type: size;
  }

  .cat-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    max-height: 100%;
  }

  .hint {
    color: #000;
    pointer-events: none;
  }

  .hint-text {
    font-family: "Montserrat", sans-serif;
    font-weight: 400;
    font-size: clamp(1.25rem, 3.2cqw, 2rem);
    text-align: center;
  }

  .counter {
    font-family: "Montserrat", sans-serif;
    font-weight: 400;
    font-size: clamp(0.9rem, 2.2cqw, 1.25rem);
    color: #666;
    text-align: center;
  }

  .bleh {
    display: block;
    width: min(650px, 75cqw, 55cqh);
    aspect-ratio: 1 / 1;
    padding: 0;
    border: none;
    background: none;
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    touch-action: manipulation;
    user-select: none;
  }

  .bleh:focus,
  .bleh:focus-visible {
    outline: none;
  }

  .image {
    display: block;
    position: relative;
    top: -1px;
    width: 100%;
    height: calc(100% + 2px);
    object-fit: cover;
  }
</style>

<script>
  import { detectLang, renderTranslations } from "../scripts/lang-switcher";

  const button = document.getElementById("bleh-button") as HTMLButtonElement;
  const image = document.getElementById("bleh-image") as HTMLImageElement;
  const audio = document.getElementById("bleh-audio") as HTMLAudioElement;
  const countEl = document.getElementById("bleh-count") as HTMLSpanElement;

  const notBlehSrc = button.dataset.notBleh!;
  const blehSrc = button.dataset.bleh!;

  const API_URL = "https://api.bleh.cat/bleh-count";

  new Image().src = blehSrc;

  let isAnimating = false;

  function renderCount(count: string) {
    countEl.dataset.i18nCount = count;
    renderTranslations(detectLang());
  }

  async function fetchCount() {
    try {
      const res = await fetch(API_URL);
      const { count } = await res.json();
      renderCount(String(count));
    } catch {
      renderCount("?");
    }
  }

  async function incrementCount() {
    try {
      const res = await fetch(`${API_URL}/increment`, { method: "POST" });
      const { count } = await res.json();
      renderCount(String(count));
    } catch {
      // keep the previous value shown
    }
  }

  fetchCount();

  button.addEventListener("click", () => {
    if (isAnimating) return;
    isAnimating = true;
    button.disabled = true;

    image.src = blehSrc;
    audio.currentTime = 0;
    audio.play();
    incrementCount();

    setTimeout(() => {
      image.src = notBlehSrc;
      isAnimating = false;
      button.disabled = false;
    }, 1300);
  });
</script>
