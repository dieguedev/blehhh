---
import notBleh from "../assets/not-bleh.png";
import blehhh from "../assets/blehhh.png";
import blehSound from "../assets/bleh.mp3";
---

<div class="stage">
  <div class="cat-wrap">
    <div class="hint">
      <span class="hint-text">haz click en el gato :)</span>
    </div>
    <button
      id="bleh-button"
      class="bleh"
      type="button"
      aria-label="Bleh"
      data-not-bleh={notBleh.src}
      data-bleh={blehhh.src}
    >
      <img id="bleh-image" class="image" src={notBleh.src} alt="" />
    </button>
  </div>
  <audio id="bleh-audio" src={blehSound}></audio>
</div>

<style>
  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
  }

  .cat-wrap {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .hint {
    position: absolute;
    top: 2%;
    right: -8%;
    z-index: 2;
    color: #000;
    transform: rotate(25deg);
    pointer-events: none;
  }

  .hint-text {
    font-family: "Fraunces", serif;
    font-weight: 400;
    font-size: clamp(1.25rem, 3.2vw, 2rem);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .hint {
      display: none;
    }
  }

  .bleh {
    display: block;
    width: 800px;
    height: 800px;
    max-width: 100%;
    padding: 0;
    border: none;
    background: none;
    overflow: hidden;
    cursor: pointer;
  }

  .image {
    display: block;
    position: relative;
    top: -1px;
    width: 100%;
    height: calc(100% + 2px);
    object-fit: cover;
  }
</style>

<script>
  const button = document.getElementById("bleh-button") as HTMLButtonElement;
  const image = document.getElementById("bleh-image") as HTMLImageElement;
  const audio = document.getElementById("bleh-audio") as HTMLAudioElement;

  const notBlehSrc = button.dataset.notBleh!;
  const blehSrc = button.dataset.bleh!;

  // Precargamos la imagen de bleh para que el swap sea instantáneo.
  new Image().src = blehSrc;

  let isAnimating = false;

  button.addEventListener("click", () => {
    if (isAnimating) return;
    isAnimating = true;
    button.disabled = true;

    image.src = blehSrc;
    audio.currentTime = 0;
    audio.play();

    setTimeout(() => {
      image.src = notBlehSrc;
      isAnimating = false;
      button.disabled = false;
    }, 1300);
  });
</script>
